* {
    font: "Inter 12";
    background-color: transparent;
    text-color: #e3efff;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: north;
    anchor: north;
    y-offset: 72px;
    width: 560px;
    background-color: #0b1222;
    border: 1px;
    border-color: #ffffff42;
    border-radius: 22px;
}

mainbox { padding: 12px; spacing: 8px; children: [ inputbar, message, listview ]; }

inputbar {
    padding: 9px 14px;
    spacing: 10px;
    border: 1px;
    border-color: #ffffff29;
    border-radius: 18px;
    children: [ prompt, entry ];
}
prompt { text-color: #8cc3ff; }
entry { text-color: #f2f8ff; }

message {
    padding: 10px 14px;
    border: 1px;
    border-color: #82b9ff4d;
    border-radius: 14px;
    background-color: #ffffff08;
}
textbox { text-color: #e1eeffd9; background-color: transparent; }

listview { lines: 7; columns: 1; fixed-height: false; scrollbar: false; spacing: 4px; }

element {
    padding: 9px 14px;
    spacing: 10px;
    border: 1px;
    border-color: transparent;
    border-radius: 18px;
}
element selected.normal {
    background-color: #ffffff17;
    border-color: #ffffff47;
    text-color: #ffffff;
}
element-text { vertical-align: 0.5; text-color: inherit; }
element-icon { size: 0px; }
